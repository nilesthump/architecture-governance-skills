{
  "type": "object",
  "required": [
    "suiteVersion",
    "identity",
    "version",
    "revision",
    "candidateDigest",
    "artifacts",
    "diagrams",
    "verification"
  ],
  "properties": {
    "suiteVersion": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "identity": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "candidateDigest": {
      "type": "string"
    },
    "artifacts": {
      "type": "object"
    },
    "diagrams": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    }
  }
}
