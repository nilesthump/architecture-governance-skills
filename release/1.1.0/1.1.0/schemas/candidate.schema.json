{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "title",
    "requirements",
    "decisions",
    "openQuestions",
    "sections",
    "diagrams"
  ],
  "properties": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejectedAlternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "text"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["accepted", "candidate", "rejected"]
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "applicable", "reason"],
        "properties": {
          "name": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "content"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ARCH-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "tradeoffs": {
            "type": "string"
          },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "sectionIds"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest", "snapshot"],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot": {
          "type": "string"
        }
      }
    }
  }
}
